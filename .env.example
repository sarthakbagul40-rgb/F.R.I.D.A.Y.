# =====================================================================
# F.R.I.D.A.Y. OS — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and fill in your API keys.
# =====================================================================

# Google Gemini API Key (Google AI Studio)
# Get it at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_gemini_api_key_here

# Groq Cloud API Key (Ultra-Fast LPU Inference - Free Tier)
# Get it at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# OpenAI API Key (Optional)
OPENAI_API_KEY=your_openai_api_key_here

# GitHub Token for Autonomous Repository Dispatch (Optional)
GITHUB_TOKEN=your_github_token_here
